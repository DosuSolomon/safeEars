{
  "name": "Rating",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
    },
    "seeker_id": {
      "type": "string",
    },
    "listener_id": {
      "type": "string",
    },
    "stars": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "default": 5,
    },
    "comment": {
      "type": "string",
    },
    "would_follow_up": {
      "type": "boolean",
      "default": false,
    },
  },
  "required": ["session_id", "seeker_id", "listener_id", "stars"],
}
