DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
API_PUBLIC_URL="http://localhost:4000/api"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password

# Required for registration verification and password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SafeEars <no-reply@example.com>"

# Optional Google OAuth login. Set the callback URL to
# https://YOUR_API_HOST/api/auth/google/callback in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
